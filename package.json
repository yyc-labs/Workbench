    "ai:commit:dry": "pwsh -File skills/auto-git-commit/scripts/auto_commit.ps1 -All -UseAi -DryRun",
    "ai:commit:split:dry": "pwsh -File skills/auto-git-commit/scripts/auto_commit.ps1 -All -UseAi -Split -SplitDryRun",
    "ai:commit:split": "pwsh -File skills/auto-git-commit/scripts/auto_commit.ps1 -All -UseAi -Split",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w node-pty",
    "rebuild:pty": "electron-rebuild -f -w node-pty",
    "test": "echo \"Error: no test specified\" && exit 1"

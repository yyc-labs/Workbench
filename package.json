{
  "name": "workbench",
  "version": "1.0.1",
  "private": true,
  "description": "An elegant desktop workspace for AI coding agents, projects, Git, notes, and developer workflows.",
  "license": "MIT",
  "author": "yyc <yyc200501317710@gmail.com>",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "node script/release/dist-win.mjs",
    "preview": "electron-vite preview",
    "ai:commit": "pwsh -File script/auto-git-commit/auto_commit.ps1 -All -UseAi",
    "ai:commit:dry": "pwsh -File script/auto-git-commit/auto_commit.ps1 -All -UseAi -DryRun",
    "ai:commit:split:dry": "pwsh -File script/auto-git-commit/auto_commit.ps1 -All -UseAi -Split -SplitDryRun",
    "ai:commit:split": "pwsh -File script/auto-git-commit/auto_commit.ps1 -All -UseAi -Split",
    "check:style": "node script/check-style.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify": "npm run typecheck && npm run check:style && npm test",
    "postinstall": "electron-rebuild -f -w node-pty",
    "rebuild:pty": "electron-rebuild -f -w node-pty",
    "test": "node --test test/**/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/rebuild": "^3.6.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@milkdown/core": "^7.22.1",
    "@milkdown/plugin-history": "^7.22.1",
    "@milkdown/plugin-listener": "^7.22.1",
    "@milkdown/preset-commonmark": "^7.22.1",
    "@milkdown/preset-gfm": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "@milkdown/theme-nord": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.55.1",
    "monaco-textmate": "^3.0.1",
    "react": "^18.3.1",
    "react-arborist": "^3.7.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6.30.3",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "zustand": "^4.5.7"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "playwright-core": "^1.61.1"
  }
}

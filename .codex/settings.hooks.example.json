{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "SessionStart"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "UserPromptSubmit"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "PreToolUse"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "PermissionRequest"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "PostToolUse"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "PreCompact"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "PostCompact"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "SubagentStart"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "SubagentStop"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "~/.codex/hooks/agent-hook-forwarder.mjs",
              "codex-cli",
              "Stop"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
